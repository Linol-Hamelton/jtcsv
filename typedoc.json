{
  "$schema": "https://typedoc.org/schema.json",
  // Document the source barrel, not index.d.ts: TypeScript drops a .d.ts
  // whenever the sibling .ts exists (it treats it as that file's emit), so
  // index.d.ts is never part of any program and typedoc found no entry
  // points at all. index.ts is the real public surface and carries the
  // JSDoc that the @deprecated / @category tags below rely on.
  "entryPoints": ["./index.ts"],
  "tsconfig": "./tsconfig.build.json",
  // Generated output goes to a build-only directory, never into
  // docs/api. `cleanOutputDir` below wipes the target first, and
  // docs/api holds four hand-authored subpath reference pages
  // (csv/json/streams/errors.md) that VitePress builds the site from —
  // pointing typedoc there deletes them on every docs build.
  // .github/workflows/docs.yml copies this directory into the published
  // site under /api/, where it sits alongside those pages.
  "out": "./docs/.typedoc",
  "name": "jtcsv API Documentation",
  "readme": "./docs/API_INTRO.md",
  "includeVersion": true,
  "categorizeByGroup": true,
  "categoryOrder": [
    "Core Conversion",
    "Streaming",
    "NDJSON",
    "TSV",
    "File Operations",
    "Error Handling",
    "Utilities",
    "*"
  ],
  "defaultCategory": "Other",
  "sort": ["source-order", "alphabetical"],
  "visibilityFilters": {
    "protected": false,
    "private": false,
    "inherited": true,
    "external": false
  },
  "theme": "default",
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "searchInComments": true,
  "cleanOutputDir": true,
  "hideGenerator": false,
  "githubPages": true,
  "gitRemote": "origin",
  "sourceLinkTemplate": "https://github.com/Linol-Hamelton/jtcsv/blob/{gitRevision}/{path}#L{line}"
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Production-only: tsc emits ONLY declarations; rollup is the sole .js producer.
    // Drops ~30 duplicate .js files from dist/ and stops the tsc/rollup race.
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "declarationDir": "./dist/types",
    "outDir": "./dist/types",
    "sourceMap": false,
    "inlineSources": false,
    "inlineSourceMap": false,

    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,

    "removeComments": true,
    "stripInternal": true,
    "incremental": false
  },
  "include": [
    "src/**/*.ts",
    "index*.ts",
    "csv-to-json.ts",
    "json-to-csv.ts",
    "stream-*.ts",
    "errors.ts",
    "schema.d.ts",
    "browser.d.ts",
    "workers.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-types",
    "benchmarks",
    "demo",
    "docs",
    "examples",
    "packages",
    "plugins",
    "scripts",
    "test-d",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/__mocks__/**",
    "src/browser/extensions/plugins.ts"
  ]
}
